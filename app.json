{
  "expo": {
    "name": "Sonic",
    "slug": "sonic",
    "version": "3.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/sonicIcons/ios/AppIcon~ios-marketing.png",
    "scheme": "sonic",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/sonicIcons/ios/AppIcon~ios-marketing.png",
      "buildNumber": "5"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundImage": "./assets/images/sonicIcons/android/res/mipmap-xxxhdpi/ic_launcher_background.png",
        "foregroundImage": "./assets/images/sonicIcons/android/res/mipmap-xxxhdpi/ic_launcher_foreground.png",
        "monochromeImage": "./assets/images/sonicIcons/android/res/mipmap-xxxhdpi/ic_launcher_monochrome.png"
      },
      "versionCode": 5,
      "package": "com.itsishandev.sonic"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/sonicIcons/web/favicon.ico",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-secure-store",
      "expo-font",
      "expo-navigation-bar"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/7cefc623-c5dc-4d02-8a7f-af9d2865e177",
      "enabled": true,
      "checkAutomatically": "NEVER"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "7cefc623-c5dc-4d02-8a7f-af9d2865e177"
      }
    }
  }
}